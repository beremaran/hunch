# Copy to .env and fill in. .env is gitignored and must never be committed.

# Telegram (phase 6)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_ID=

# Models
HUNCH_LLM_MODEL_ID=Qwen/Qwen3.5-9B
HUNCH_EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
# Optional: where Hugging Face caches model weights (default: %USERPROFILE%\.cache\huggingface)
HF_HOME=
# Optional: only needed for gated models or higher download rate limits
HF_TOKEN=

# Runtime paths
HUNCH_DATA_DIR=data
HUNCH_LOG_DIR=logs
